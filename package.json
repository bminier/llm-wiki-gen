{
  "name": "llm-wiki-gen",
  "version": "0.1.0-dev",
  "description": "Local-first agent-driven Markdown knowledge base curated from a read-only source allowlist. Implements the Karpathy LLM Wiki pattern.",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "llm-wiki-gen": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "citty": "^0.1.6",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.13",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bminier/llm-wiki-gen.git"
  },
  "keywords": [
    "llm",
    "wiki",
    "obsidian",
    "knowledge-base",
    "agentic",
    "mcp",
    "local-first",
    "ollama"
  ],
  "trustedDependencies": ["@biomejs/biome"]
}
